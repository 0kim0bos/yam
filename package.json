{
  "name": "yam-flow",
  "version": "0.1.6",
  "description": "Progressive proof-first agent flow: start fast, deepen deliberately, stay honest by design.",
  "type": "module",
  "author": "0kim0bos",
  "homepage": "https://github.com/0kim0bos/yam#readme",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/0kim0bos/yam.git"
  },
  "bugs": {
    "url": "https://github.com/0kim0bos/yam/issues"
  },
  "engines": {
    "node": ">=18"
  },
  "bin": {
    "yam": "dist/bin/yam.js"
  },
  "types": "dist/lib/trust-kernel.d.ts",
  "exports": {
    "./trust-kernel": {
      "types": "./dist/lib/trust-kernel.d.ts",
      "import": "./dist/lib/trust-kernel.js"
    }
  },
  "files": [
    "AGENTS.md",
    "CHANGELOG.md",
    "COMMANDS.md",
    "DECISIONS.md",
    "LICENSE",
    "README.md",
    "ROADMAP.md",
    "dist",
    "src",
    "tsconfig.json",
    "references",
    "skills",
    "templates",
    "yam.manifest.json"
  ],
  "scripts": {
    "clean": "node -e \"require('node:fs').rmSync('dist',{recursive:true,force:true})\"",
    "build": "npm run clean && tsc -p tsconfig.json",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "install:skills": "node ./dist/bin/yam.js install",
    "uninstall:skills": "node ./dist/bin/yam.js uninstall",
    "status": "node ./dist/bin/yam.js status",
    "verify": "node ./dist/bin/yam.js verify",
    "doctor": "node ./dist/bin/yam.js doctor",
    "list": "node ./dist/bin/yam.js list",
    "examples": "node ./dist/bin/yam.js examples",
    "verify:self": "npm run build && node --check ./dist/bin/yam.js && node --check ./dist/lib/trust-kernel.js && node ./dist/bin/yam.js verify && node ./dist/bin/yam.js doctor",
    "prepare": "npm run build",
    "prepack": "npm run verify:self",
    "prepublishOnly": "npm run verify:self",
    "pack:dry-run": "npm pack --dry-run",
    "publish:dry": "npm publish --dry-run --access public",
    "forbidden-names:check": "node ./scripts/check-forbidden-names.mjs",
    "package-boundary:check": "node ./scripts/check-package-boundary.mjs",
    "dist:freshness": "node ./scripts/check-dist-freshness.mjs",
    "registry:check": "node ./scripts/check-registry-version.mjs",
    "cli-smoke": "node ./scripts/cli-smoke.mjs",
    "release:check": "npm run typecheck && npm run forbidden-names:check && npm run verify:self && npm run dist:freshness && npm run package-boundary:check && npm run registry:check && npm run cli-smoke",
    "budget": "node ./dist/bin/yam.js budget",
    "measure": "node ./dist/bin/yam.js measure",
    "tools": "node ./dist/bin/yam.js tools",
    "proof": "node ./dist/bin/yam.js proof",
    "safety": "node ./dist/bin/yam.js safety",
    "detect": "node ./dist/bin/yam.js detect",
    "pack": "node ./dist/bin/yam.js pack",
    "memory": "node ./dist/bin/yam.js memory",
    "template": "node ./dist/bin/yam.js template",
    "tune-log": "node ./dist/bin/yam.js tune-log",
    "init-project": "node ./dist/bin/yam.js init-project"
  },
  "keywords": [
    "codex",
    "harness",
    "codex-skills",
    "ai-agents",
    "developer-tools",
    "verification",
    "ui-review",
    "proof-first",
    "skills",
    "proof",
    "ui"
  ],
  "publishConfig": {
    "access": "public",
    "registry": "https://registry.npmjs.org/",
    "tag": "latest"
  },
  "license": "MIT",
  "devDependencies": {
    "@types/node": "^25.9.1",
    "playwright": "^1.60.0",
    "typescript": "^6.0.3"
  }
}
